# Maintainer: thefoulowl <thefoulowl@proton.me>
pkgname=provctl
pkgver=0.1.1
pkgrel=1
pkgdesc="eBPF process/file/network provenance tracker and flight recorder"
arch=('x86_64')
url="https://github.com/thefoulowl/provctl"
license=('MIT')
depends=()
makedepends=('go>=1.25')
optdepends=('systemd: run provctl watch as a service')
source=("$pkgname-$pkgver.tar.gz::https://github.com/thefoulowl/provctl/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f2b85a137f4847c20c48920ee7dfb3602d744d8e013371bc1f2edc3f25130da7')

build() {
	cd "$pkgname-$pkgver"
	export CGO_ENABLED=0
	go build -trimpath -o provctl ./cmd/provctl
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 provctl "$pkgdir/usr/bin/provctl"
	install -Dm644 packaging/systemd/provctl.service "$pkgdir/usr/lib/systemd/system/provctl.service"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
